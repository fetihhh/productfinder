# .env.local olarak kopyalayın ve doldurun. Bu dosyaya gerçek değer YAZMAYIN.

# Giriş (tek kullanıcı)
APP_PASSWORD=
# Uzun rastgele bir değer: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Supabase (Project Settings → API). Gizli anahtar yalnızca sunucuda kullanılır.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Kaynaklar: RSS blogları anahtar gerektirmez. Reddit yalnızca API onayı alınırsa.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Pazaryeri araması (Faz C)
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Reklam sinyali: Meta Reklam Kütüphanesi API'si (ücretsiz). README → Reklam sinyali. ~60 günde bir yenilenir.
META_ACCESS_TOKEN=

# Türkiye reklamları: Google Reklam Şeffaflık Merkezi (BigQuery, ücretsiz deneme alanı). Hizmet hesabı anahtarının JSON içeriği.
GOOGLE_BQ_CREDENTIALS=
