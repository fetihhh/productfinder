# .env.local olarak kopyalayın ve doldurun. Bu dosyaya gerçek değer YAZMAYIN.

# Giriş (tek kullanıcı)
APP_PASSWORD=
# Uzun rastgele bir değer: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Supabase (Project Settings → API). Gizli anahtar yalnızca sunucuda kullanılır.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Kaynaklar: RSS blogları anahtar gerektirmez. Reddit yalnızca API onayı alınırsa.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Pazaryeri araması (Faz C)
TAVILY_API_KEY=
